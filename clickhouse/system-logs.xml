<?xml version="1.0"?>
<!--
  Tabelas de log INTERNAS do ClickHouse (system.*): quase todas DESABILITADAS.

  Histórico (2 incidentes reais neste deploy):
  1. system.trace_log chegou a 21 GiB / 1 bilhão de linhas (profiler global
     ligado por padrão) enquanto a telemetria do SigNoz somava < 1 GiB.
  2. system.metric_log derrubou o servidor por CPU: ela tem ~1.200 colunas
     (uma por métrica interna) e o MERGE dela abre um stream de escrita por
     coluna — em máquina de 7,5 GiB o merge estoura MEMORY_LIMIT_EXCEEDED e
     re-tenta em loop infinito (6k+ falhas), cravando 100%+ de CPU pra sempre.
     TTL não resolve isso: o problema é o merge em si, não a retenção.

  Por isso: remove="1" em tudo que é pesado. São dados de diagnóstico do
  próprio banco, sem valor pra esta stack. Só a query_log fica (leve e útil
  pra investigar queries lentas), com partição diária + TTL curto.
-->
<clickhouse>
    <!-- CAUSA RAIZ do inchaço da trace_log: o profiler GLOBAL, que vem ligado
         por padrão (10s) e amostra TODAS as threads do servidor, inclusive as
         de background (merges etc.) — essas linhas têm query_id = ''. Medido
         localmente: ~116k linhas em 5 min, ~33M/dia, e eram 99% do volume.

         Atenção: isto é server-level. Desabilitar query_profiler_* no users.xml
         NÃO afeta essas threads (cobre só queries de usuário). Precisa ser aqui. -->
    <global_profiler_real_time_period_ns>0</global_profiler_real_time_period_ns>
    <global_profiler_cpu_time_period_ns>0</global_profiler_cpu_time_period_ns>

    <!-- Desabilitadas. Depois de mudar aqui: docker compose restart clickhouse
         e DROP TABLE IF EXISTS system.<tabela> SYNC (a config só impede a
         RECRIAÇÃO; a tabela existente continua no disco até o drop). -->
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_views_log remove="1"/>
    <query_thread_log remove="1"/>
    <latency_log remove="1"/>

    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMMDD(event_date)</partition_by>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
</clickhouse>
