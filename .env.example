# Copie para .env e preencha (ou rode ./generate-env.sh para gerar automaticamente).

# Segredo usado para assinar os tokens de sessão (JWT) do SigNoz.
# DEVE ser um valor forte e secreto. Gere com:  openssl rand -base64 32
SIGNOZ_JWT_SECRET=

# ---------------------------------------------------------------------------
# (Opcional) SMTP para envio de e-mail de alertas. Deixe em branco se não usar.
# Para habilitar, também mude SIGNOZ_EMAILING_ENABLED=true no docker-compose.yaml
# SIGNOZ_EMAILING_SMTP_ADDRESS=smtp.exemplo.com:587
# SIGNOZ_EMAILING_SMTP_FROM=alertas@exemplo.com
# SIGNOZ_EMAILING_SMTP_AUTH_USERNAME=usuario
# SIGNOZ_EMAILING_SMTP_AUTH_PASSWORD=senha
